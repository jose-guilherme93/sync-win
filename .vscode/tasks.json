{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SyncWin: Iniciar interface",
      "detail": "Inicia a API e a interface Svelte; abra http://localhost:5173 no navegador.",
      "type": "shell",
      "command": "make dev-d DEV_HTTP_PORT=18080",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "SyncWin: Ver logs da interface",
      "type": "shell",
      "command": "make dev-logs",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "SyncWin: Parar interface",
      "type": "shell",
      "command": "make dev-down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
