{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LEM: Iniciar interface",
      "detail": "Inicia a API e a interface Svelte; abra http://localhost:5173 no navegador.",
      "type": "shell",
      "command": "make dev-d LEM_HTTP_PORT=18080",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "LEM: Ver logs da interface",
      "type": "shell",
      "command": "make dev-logs",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "LEM: Parar interface",
      "type": "shell",
      "command": "make dev-down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "LEM: Gerar protótipo OpenPencil",
      "detail": "Regera o arquivo editável .fig e a imagem de preview do protótipo completo.",
      "type": "shell",
      "command": "bash prototypes/openpencil/build.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
