# =============================================================================
# LEM — Linux Environment Manager
# Environment Variables Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# Do NOT commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Docker Hub (for CI/CD image publishing)
# ---------------------------------------------------------------------------
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_TOKEN=your-dockerhub-access-token

# ---------------------------------------------------------------------------
# Image settings
# ---------------------------------------------------------------------------
IMAGE_NAME=linux-environment-manager
IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# LEM Server
# ---------------------------------------------------------------------------
# Secret key for AES-256 encryption of notification credentials.
# REQUIRED in production. Minimum 16 characters.
# Generate with: openssl rand -hex 32  (or: make secret)
#
# WARNING: changing this key makes previously stored notification credentials
# undecryptable. If you are migrating from the default dev key, keep using the
# same value here instead of generating a new one.
LEM_SECRET_KEY=

# Set to "development" to allow booting without LEM_SECRET_KEY.
# NEVER use "development" in production.
LEM_ENV=production

# Security feature flags. All are fail-closed (false) by default.
# Enable only after the corresponding security controls are deployed.
LEM_ENABLE_FINGERPRINT_RECONNECT=false
LEM_ENABLE_LEGACY_INSTALL=false
LEM_ENABLE_REMOTE_MUTATIONS=false
LEM_ENABLE_DOCKER_MUTATIONS=false

# Optional exact browser origin allowed to call the API (development only).
# Leave empty for same-origin production deployments.
LEM_CORS_ALLOWED_ORIGIN=

# Set to true only when the server is behind HTTPS termination.
LEM_HTTPS=false

# Public base URL embedded in generated agent install scripts. Recommended
# behind a reverse proxy so the installer never trusts X-Forwarded-Proto/Host.
# Example: LEM_PUBLIC_URL=https://lem.example.com
LEM_PUBLIC_URL=

# Dashboard session lifetime in hours (default: 720 = 30 days).
LEM_SESSION_TTL_HOURS=720

# Host port for the production server (default: 8080; Coolify).
LEM_HTTP_PORT=8080

# Host port for the `make dev` server (default: 8088).
DEV_HTTP_PORT=8088

# Host port for the Vite dev server, used by `make dev` (default: 5173).
WEB_PORT=5173

# Server listen address inside the container (default: ":8080")
LEM_HTTP_ADDR=:8080

# Directory for SQLite database and mirrored files (default: "/data")
LEM_DATA_DIR=/data

# Path to the built web dashboard (default: "/app/web", baked into image)
LEM_WEB_DIR=/app/web

# Override agent version string (default: read from contract.json at build time)
# LEM_AGENT_VERSION=0.6.1

# Path to agent binary served by download endpoint (default: "/app/lem-agent")
LEM_AGENT_BINARY=/app/lem-agent

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARN, ERROR (default: INFO)
LOG_LEVEL=INFO

# Console log level (default: WARN)
LOG_CONSOLE_LEVEL=WARN
