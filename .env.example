# =============================================================================
# SyncWin — environment variables
# =============================================================================
# Copy this file to .env (or paste the values into your platform's environment
# tab, e.g. Dokploy) and fill in the values.
#
# ONLY "SYNCWIN_SECRET_KEY" IS REQUIRED to boot. Every other variable has a safe
# default baked into compose.yaml / compose.prod.yaml. To sign in when public
# registration is disabled (the production default), also set
# SYNCWIN_ADMIN_EMAIL and SYNCWIN_ADMIN_PASSWORD. Do NOT commit .env.
#
# Quick start:
#   make env      # creates .env and fills SYNCWIN_SECRET_KEY automatically
#   make secret   # prints a fresh key
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------
# Secret key for AES-256 encryption of notification credentials and session
# signing. REQUIRED in production. Minimum 16 characters.
# Generate with: openssl rand -hex 32  (or: make secret)
#
# WARNING: changing this key makes previously stored notification credentials
# undecryptable.
SYNCWIN_SECRET_KEY=

# ---------------------------------------------------------------------------
# RECOMMENDED when running behind a reverse proxy with TLS (Dokploy, Coolify…)
# ---------------------------------------------------------------------------
# Set to true when the server is served over HTTPS (TLS terminated by the
# proxy). MUST stay false for plain http://localhost, otherwise the session
# cookie is marked Secure and sign-in fails.
SYNCWIN_HTTPS=false

# Trust X-Forwarded-For / X-Real-IP when determining the client IP for rate
# limiting. Set true only behind a reverse proxy you control; false means
# clients cannot spoof their address.
SYNCWIN_TRUST_PROXY=false

# Public base URL embedded in generated agent install scripts. Set it so the
# installer never trusts X-Forwarded-Proto/Host from the proxy.
# Example: SYNCWIN_PUBLIC_URL=https://sync-win.example.com
SYNCWIN_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Optional server settings
# ---------------------------------------------------------------------------
# Runtime mode. Keep "production" unless developing locally against the source.
# "development" allows booting without SYNCWIN_SECRET_KEY — never use it in
# production.
SYNCWIN_ENV=production

# Security feature flags. All fail-closed (false) by default. Enable only after
# the corresponding security controls are deployed.
SYNCWIN_ENABLE_FINGERPRINT_RECONNECT=false
SYNCWIN_ENABLE_LEGACY_INSTALL=false
SYNCWIN_ENABLE_REMOTE_MUTATIONS=false
SYNCWIN_ENABLE_DOCKER_MUTATIONS=false

# Public self-registration. Disabled by default: on a public deployment any
# visitor could otherwise create an account. Use the admin account below
# instead, or set true only if you intentionally want open sign-ups.
SYNCWIN_ENABLE_REGISTRATION=false

# Initial admin account, created automatically on first boot when both are set.
# With registration disabled this is how the first account exists. An existing
# account is never modified, so a password changed in the dashboard is kept.
SYNCWIN_ADMIN_EMAIL=
SYNCWIN_ADMIN_PASSWORD=

# Optional exact browser origin allowed to call the API (development only).
# Leave empty for same-origin production deployments.
SYNCWIN_CORS_ALLOWED_ORIGIN=

# Dashboard session lifetime in hours (default: 720 = 30 days).
SYNCWIN_SESSION_TTL_HOURS=720

# Host port for the production server (compose.prod.yaml, default: 8080).
# Ignored by platforms that route through the container port directly.
SYNCWIN_HTTP_PORT=8080

# Production data location (compose.prod.yaml). Defaults to the named volume
# "sync-win-data". Set to ./data for a host bind mount.
# SYNCWIN_DATA_PATH=./data

# Logging: LOG_LEVEL is DEBUG|INFO|WARN|ERROR, LOG_CONSOLE_LEVEL controls the
# human-readable console output (defaults: INFO / WARN).
LOG_LEVEL=INFO
LOG_CONSOLE_LEVEL=WARN

# ---------------------------------------------------------------------------
# Image settings (optional — defaults are fine)
# ---------------------------------------------------------------------------
# Which image the production stack runs. Leave commented to use the built-in
# default (ghcr.io/jose-guilherme93/sync-win), which always exists because the
# Release workflow publishes there with no extra credentials.
#
# Docker Hub carries the same tags, so point at it once the release secrets
# (DOCKERHUB_USERNAME / DOCKERHUB_TOKEN) are configured:
#   IMAGE_NAME=<dockerhub-user>/sync-win
# IMAGE_NAME=sync-win
IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# Development only (ignored in production)
# ---------------------------------------------------------------------------
# Host port for the `make dev` server and for the Vite dev server.
DEV_HTTP_PORT=8088
WEB_PORT=5173

# ---------------------------------------------------------------------------
# CI/CD only (GitHub Actions image publishing — not used at runtime)
# ---------------------------------------------------------------------------
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_TOKEN=your-dockerhub-access-token
