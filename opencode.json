{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/space-bunny-free",
  "plugins": [],
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 16000
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 8000
    },
    "buffer": 12000
  },
  "agents": {
    "build": {
      "steps": 25,
      "permissions": [
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "plan": {
      "steps": 5,
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  }
}
