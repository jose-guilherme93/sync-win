# Development image for the SyncWin web dashboard.
# Source is bind-mounted at /app by compose.dev.yaml; node_modules live in a
# named volume seeded from this image so host installs never leak in.
FROM node:22-alpine

WORKDIR /app
COPY web/package.json web/package-lock.json* ./
RUN npm ci || npm install

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
