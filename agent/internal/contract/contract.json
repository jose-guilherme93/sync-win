{
  "contract_version": "1.4.0",
  "agent_version": "0.6.1",
  "collection": {
    "max_file_bytes": 524288,
    "default_preference_files": [
      "$HOME/.bashrc",
      "$HOME/.profile",
      "$HOME/.zshrc",
      "$HOME/.config/kdeglobals",
      "$HOME/.config/gtk-3.0/settings.ini",
      "$HOME/.config/gtk-4.0/settings.ini",
      "$HOME/.config/Code/User/settings.json"
    ],
    "extra_allowlist_path": "~/.config/sync-win/allowed-files",
    "excluded_files_path": "~/.config/sync-win/excluded-files",
    "categories": ["kde", "desktop", "shell", "app", "general", "workspace", "saves"],
    "rejected_content_rules": {
      "binary_or_invalid_utf8": true,
      "empty_content": true,
      "secret_patterns": [
        "pem_private_key",
        "aws_access_key_id",
        "github_token",
        "slack_token",
        "stripe_live_key",
        "google_api_key"
      ],
      "sensitive_filenames": ["id_rsa*", "id_dsa*", "id_ecdsa*", "id_ed25519*", "*.pem", "*.key", "*.p12", "*.pfx"]
    },
    "saves": {
      "roots": [
        "$HOME/.config/hydralauncher/wine-prefixes/*/drive_c/users/*/Documents",
        "$HOME/.config/hydralauncher/wine-prefixes/*/drive_c/users/*/Saved Games",
        "$HOME/.config/hydralauncher/wine-prefixes/*/drive_c/users/*/AppData/Roaming",
        "$HOME/.config/hydralauncher/ludusavi/config.yaml",
        "$HOME/.steam/steam/userdata",
        "$HOME/.var/app/com.valvesoftware.Steam/.steam/steam/userdata",
        "$HOME/.config/unity3d"
      ],
      "include_extensions": [
        ".save", ".sav", ".sgm", ".srm", ".mcr", ".mcd", ".savemeta",
        ".bin", ".dat", ".cfg", ".ini", ".json", ".yaml", ".yml", ".xml",
        ".txt", ".vdf", ".prof", ".litematic"
      ],
      "excluded_dirs": [
        "Temp", "temp", "Cache", "Code Cache", "GPUCache", "DawnGraphiteCache",
        "DawnWebGPUCache", "INetCache", "INetCookies", "History", "Crashpad",
        "blob_storage", "Shared Dictionary", "content", "Content", "CommonRedist",
        "redist", "__installer", "shadercache"
      ],
      "excluded_extensions": [".tmp", ".log", ".dmp", ".bak", ".old", ".lock"],
      "max_save_file_bytes": 1048576,
      "max_total_bytes_per_cycle": 16777216,
      "max_depth": 12
    },
    "workspace": {
      "files": [".vscode/settings.json", ".vscode/tasks.json", ".vscode/launch.json"],
      "max_file_bytes": 262144,
      "max_total_bytes": 2097152
    }
  },
  "telemetry": {
    "interval_seconds_default": 10,
    "fields": [
      "cpu_usage_percent",
      "memory_used_bytes",
      "memory_total_bytes",
      "disk_read_bytes",
      "disk_write_bytes",
      "disk_read_rate",
      "disk_write_rate",
      "net_rx_rate",
      "net_tx_rate",
      "uptime_seconds",
      "load_average",
      "cpu_model",
      "kernel",
      "operating_system",
      "power_watts",
      "architecture",
      "desktop_environment",
      "locale",
      "timezone",
      "agent_version"
    ],
    "rate_semantics": {
      "net_rx_rate": "Bytes per second, summed over real interfaces only. The dashboard must not re-sum network_ifaces.",
      "net_tx_rate": "Bytes per second, summed over real interfaces only."
    },
    "network_interface_filter": {
      "excluded_prefixes": [
        "lo",
        "veth",
        "br-",
        "br0",
        "docker",
        "virbr",
        "vnet",
        "cni",
        "flannel",
        "cali",
        "kube-ipvs"
      ],
      "rationale": "Container and VM plumbing reports the same bytes on the veth pair, its bridge and docker0. Summing them inflates network totals several times over. Real NICs and deliberate tunnels (tailscale, wireguard, tun/tap) are kept.",
      "kept_examples": ["eth0", "wlan0", "enp3s0", "tailscale0", "wg0", "tun0", "tap0"]
    },
    "disk_partition_dedup": {
      "by_device": true,
      "exempt_filesystems": ["btrfs"],
      "rationale": "ext4 reports /home, /root, /srv and friends as separate mounts of one device, which listed the same disk several times. Btrfs subvolumes are independent mounts and are kept."
    }
  },
  "apps_inventory": {
    "sources": ["apt", "flatpak", "pacman", "aur", "appimage"],
    "refresh_interval_seconds": 300
  },
  "system_inventory": {
    "refresh_interval_seconds": 300,
    "services": {
      "max_units": 400,
      "timeout_seconds": 10,
      "states": ["running", "failed", "stopped"],
      "enabled_states": ["enabled", "enabled-runtime"]
    },
    "ports": {
      "max_ports": 200,
      "timeout_seconds": 10,
      "listening_states": ["LISTEN", "UNCONN"]
    }
  },
  "preferences_sync": {
    "interval_seconds_default": 300,
    "state_path": "~/.local/state/sync-win/agent-state.json"
  },
  "commands": {
    "transport": "pull_only",
    "supported_types": [
      "exclude_file", "install_app", "restore_saves",
      "docker_list_containers", "docker_container_stats", "docker_container_logs",
      "docker_container_start", "docker_container_stop", "docker_container_restart",
      "docker_container_kill", "docker_container_remove", "docker_system_prune",
      "docker_image_prune", "docker_container_prune", "docker_network_prune",
      "docker_exec",
      "docker_compose_read", "docker_compose_write", "docker_compose_up",
      "docker_compose_down", "docker_compose_ps", "docker_compose_logs",
      "lynis_audit"
    ],
    "timeout_seconds_default": 900,
    "output_cap_bytes": 65536,
    "docker_logs_max_tail": 2000,
    "policy_path": "~/.config/sync-win/policy.json",
    "policy_defaults": {
      "allow_install_app": false,
      "allow_exclude_file": false,
      "allow_restore_saves": false,
      "allow_lynis_audit": true,
      "allow_docker_read": true,
      "allow_docker_lifecycle": false,
      "allow_docker_exec": false,
      "allow_docker_prune": false,
      "allow_docker_compose": false,
      "command_timeout_seconds": 900
    },
    "docker_exec_timeout_seconds": 30
  },
  "security_audit": {
    "enabled": true,
    "lynis_timeout_seconds": 600,
    "report_max_bytes": 1048576
  },
  "resilience": {
    "http_timeout_seconds": 15,
    "backoff_base_multiplier": 2,
    "backoff_max_seconds": 600,
    "jitter_fraction": 0.1
  },
  "server_limits_mirrored": {
    "max_request_bytes": 2097152,
    "max_file_bytes_server": 262144,
    "max_save_bytes_server": 1048576
  }
}
